{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile authenticated with Firebase Auth",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID" },
        "name": { "type": "string", "description": "Display name" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "authProvider": { "type": "string", "description": "google or password" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["uid", "email"]
    },
    "ChatSessionDoc": {
      "title": "ChatSessionDoc",
      "description": "Saved chat sessions per user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "messages": { "type": "string", "description": "JSON stringified messages" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User private profile document"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "ChatSessionDoc",
      "description": "User's chat sessions and messages"
    }
  }
}
